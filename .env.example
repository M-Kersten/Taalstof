# Spotify: Client ID van je app op developer.spotify.com (PKCE, geen secret nodig)
SPOTIFY_CLIENT_ID=
# Optioneel: Musixmatch API-sleutel van developer.musixmatch.com. Leeg laten als je de tekst zelf plakt
MUSIXMATCH_API_KEY=
# Anthropic API-sleutel van console.anthropic.com
ANTHROPIC_API_KEY=
# Model-ID voor de lesgeneratie
ANTHROPIC_MODEL=claude-opus-5-5
# Hoe diep het model nadenkt: low, medium, high, xhigh of max. Hoger is nauwkeuriger en kost meer tijd en geld
ANTHROPIC_EFFORT=high
# Poort van de lokale server; de Spotify redirect-URI wordt http://127.0.0.1:PORT/callback
PORT=8787
